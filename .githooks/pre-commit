#!/bin/sh
# Auto-syncs antigravity_core/static/* into the legacy static/ mirror (and root
# rythm.html) before every commit, then re-stages anything that changed.
# Installed via: git config core.hooksPath .githooks

python scripts/sync_static_mirrors.py || python3 scripts/sync_static_mirrors.py

git add static/ rythm.html 2>/dev/null

exit 0
