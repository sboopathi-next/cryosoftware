DATABASE_URL="postgresql://username:password@ep-xyz.pooler.neon.tech/neondb?sslmode=require"
USER_PROFILE_ID="Your Name"
LEETCODE_USERNAME="your_leetcode_username"

# ── Auth (required on Vercel / online deployment) ───────────────────────────
# APP_PASSWORD: the password you type at /login
APP_PASSWORD="your_strong_password_here"
# APP_SECRET: a random token issued after login — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET="your_generated_secret_token_here"
# Set to "true" to disable auth (local offline dev only)
AUTH_DISABLED="false"
